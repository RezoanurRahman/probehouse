{
  "name": "probehouse",
  "version": "1.0.0",
  "private": true,
  "description": "Probehouse is a local-first research operations desk for planning studies, recruiting participants, scheduling moderated sessions, and closing out follow-ups.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch src/server.ts",
    "dev:all": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"npm run dev:api\" \"npm run dev\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
